{
  "permissions": {
    "defaultMode": "acceptEdits",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(start trabajo/*)",
      "PowerShell(start trabajo/*)",
      "Bash(open trabajo/*)",
      "PowerShell(open trabajo/*)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(git --version)",
      "Bash(git init*)",
      "PowerShell(git init*)",
      "Bash(git config user.*)",
      "PowerShell(git config user.*)",
      "Bash(git remote*)",
      "PowerShell(git remote*)",
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(git pull*)",
      "PowerShell(git pull*)",
      "Bash(git branch*)",
      "PowerShell(git branch*)",
      "Bash(git status*)",
      "PowerShell(git status*)",
      "Bash(git log*)",
      "PowerShell(git log*)",
      "Bash(git diff*)",
      "PowerShell(git diff*)",
      "Bash(git add *)",
      "PowerShell(git add *)",
      "Bash(git commit *)",
      "PowerShell(git commit *)"
    ],
    "ask": [
      "Bash(sed *)",
      "PowerShell(sed *)",
      "Bash(rm *)",
      "PowerShell(rm *)",
      "Bash(mv *)",
      "PowerShell(mv *)",
      "Bash(cp *)",
      "PowerShell(cp *)"
    ],
    "deny": [
      "Edit(.claude/**)",
      "Write(.claude/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "AGENTE_SIN_REMOTO": "1"
  }
}
